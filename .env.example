# Copy to .env (docker compose reads it) or export in your environment.
# Everything is optional: with no configuration at all Clpaste runs on SQLite
# with a generated key and a printed admin password.

# Generate with: clpaste keygen. If empty, a key is generated into CLPASTE_KEY_FILE.
CLPASTE_MASTER_KEY=
# Optional: normally derived from each request's Host header (plus
# X-Forwarded-Proto/Host when the peer is in CLPASTE_TRUSTED_PROXIES).
#CLPASTE_BASE_URL=https://paste.example.com

# --- database: SQLite (default) ...
#CLPASTE_DB_URL=sqlite3:///data/clpaste.db
# ... or PostgreSQL via the libpq variables (any of these selects PostgreSQL)
#PGHOST=db
#PGPORT=5432
#PGUSER=clpaste
#POSTGRES_USER_PASSWORD=change-me
#PGDATABASE=clpaste
# optional: lets Clpaste create/converge the app role and database itself
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=change-me-too

# --- OIDC (omit for ad-hoc mode with basic-auth admin only)
CLPASTE_OIDC_ISSUER=https://login.example.com/realms/main
CLPASTE_OIDC_CLIENT_ID=clpaste
CLPASTE_OIDC_CLIENT_SECRET=
CLPASTE_ADMIN_EMAILS=admin@example.com
#CLPASTE_ADMIN_CLAIM=groups=clpaste-admins

# --- basic-auth admin (optional alongside OIDC; auto-generated without it)
#CLPASTE_ADMIN_USER=admin
#CLPASTE_ADMIN_PASSWORD=

# Unprotected mode: anyone can create public pastes without signing in;
# private/team options disappear and the paste list stays admin-only.
#CLPASTE_UNPROTECTED=false

CLPASTE_SITE_NAME=Clpaste
CLPASTE_COLOR_MODE=auto
CLPASTE_TRUSTED_PROXIES=10.0.0.0/8
